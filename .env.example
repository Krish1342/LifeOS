# LifeOS Configuration

# Secret key for token encryption (AES-256-GCM 32-byte base64)
# Generated automatically on initial setup if not provided
LIFEOS_ENCRYPTION_KEY=

# MongoDB (Atlas M0 Free Tier or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lifeos?retryWrites=true&w=majority
MONGODB_DB_NAME=lifeos

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Slack Bot Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=phi3:mini
