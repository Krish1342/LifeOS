# LifeOS Configuration - 100% Free Tier (Zero cost, no credit card required)

# Secret key for token encryption (AES-256-GCM 32-byte base64)
# Run 'lifeos keygen' to generate
LIFEOS_ENCRYPTION_KEY=

# Clerk Authentication & OAuth (Free Tier: 10,000 MAUs, no credit card required)
# Create a free project at https://clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# MongoDB (Atlas M0 Free Tier 512MB or Local MongoDB - no credit card required)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lifeos?retryWrites=true&w=majority
MONGODB_DB_NAME=lifeos

# Google OAuth2 Credentials (Optional if connecting Google via Clerk)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/oauth/callback

# Slack Bot Integration (Free workspace tier - no credit card required)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Local LLM (Ollama - 100% free, runs locally on your PC, zero cloud LLM cost)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=phi3:mini
